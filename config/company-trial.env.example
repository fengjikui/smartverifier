# 复制到仓库根目录 .env.local；占位模型地址和名称必须按实际服务修改。
# 仅用于当前公司内网试用，企业 IDaaS / MES 尚未对接。
SV_RECOGNIZER=vlm
SV_HOST=0.0.0.0
SV_PORT=5190
SV_STATE_DIR=./var/data

# 正品管理员独立账号密码登录，暂不依赖 IDaaS。
# 默认 true 仅限本机；运行 npm run admin:owner 初始化负责人后再开放；普通人员由网页管理。
SV_ADMIN_LOCAL_ONLY=true
# 配置助手会自动设置此路径；不要在环境文件里填写明文密码。
# SV_ADMIN_USERS_FILE=./var/config/admin-users.json
# 临时开放：npm run admin:access -- lan；恢复：npm run admin:access -- local。
# 账号和访问范围修改后须重启业务服务。

# 默认自动选择本项目 .venv（Windows: Scripts/python.exe；macOS/Linux: bin/python）。
# 自定义解释器时才填写；相对路径以仓库根目录为基准，不需要激活环境。
# SV_VISION_PYTHON=D:/SmartVerifier/.venv/Scripts/python.exe

# 推荐使用公司提供的兼容 HTTP VLM；不会自动下载或加载模型。
SV_VLM_PROVIDER=openai-compatible
SV_VLM_ENDPOINT=http://vlm.company.internal:8000/v1
SV_VLM_MODEL=company-vision-model
SV_VLM_API_KEY=
SV_VLM_TIMEOUT_SECONDS=90
SV_VLM_EXTRA_BODY={}
# HTTPS 私有 CA 可填写证书文件，勿关闭校验。
# SV_VLM_CA_FILE=C:/SmartVerifier/company-ca.pem

SV_VISION_INPUT_LAYOUT=prefix-first
SV_VISION_SCHEMA=1
# 试用默认关闭模型调试；在服务器本机调试时再启用。
SV_MODEL_DEBUG=0

# 可选：平板连续取景需要受信任 HTTPS。已有公司 HTTPS 网关时不必启动本机入口。
# 没有网关时，在另一个终端运行 npm run https，配置公司 CA 签发的服务器证书。
# 证书 SAN 必须覆盖平板实际访问的域名/IP，平板需信任公司 CA。
# SV_HTTPS_CERT_FILE=D:/Jianwei/certs/server-fullchain.pem
# SV_HTTPS_KEY_FILE=D:/Jianwei/certs/server.key
# SV_HTTPS_HOST=0.0.0.0
# SV_HTTPS_PORT=5443
# 不设置 SV_HTTPS_TEST_CA_FILE；公司部署不开放测试证书下载口。
