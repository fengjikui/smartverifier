# 复制到仓库根目录 .env.local，再运行 npm run start:real。
# 本机基准：保留已验证的 LM Studio SDK，不改共享模型配置。
SV_VLM_PROVIDER=lmstudio
SV_VLM_ENDPOINT=http://127.0.0.1:1234/v1
SV_VLM_MODEL=hr-qwen
SV_VLM_TIMEOUT_SECONDS=55
SV_VLM_API_KEY=
SV_MODEL_DEBUG=1
SV_PORT=5190

# 正品管理员默认仅本机。先 npm run admin:account，再 admin:access -- lan 开放。
SV_ADMIN_LOCAL_ONLY=true
# SV_ADMIN_USERS_FILE=./var/config/admin-users.json

# 公司服务：将上方三项改为实际值。地址可填基础地址或完整 /chat/completions 地址。
# SV_VLM_PROVIDER=openai-compatible
# SV_VLM_ENDPOINT=http://vlm.company.internal:8000/v1
# SV_VLM_MODEL=公司服务实际对外暴露的模型名
# SV_VLM_API_KEY=由公司服务管理员提供，不能放进前端或提交到Git
# SV_VLM_TIMEOUT_SECONDS=90
# 如该服务支持Qwen的此参数，可显式关闭thinking；不支持时不要填写。
# SV_VLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# 公司HTTPS私有CA证书可指定路径，证书校验保持开启。
# SV_VLM_CA_FILE=/absolute/path/company-ca.pem
# 仅LM Studio SDK需要本机模板，HTTP公司服务不读取此文件。
# SV_VLM_TEMPLATE=/absolute/path/chat_template.jinja

# 当前固定前缀与Schema默认开启；这是基准配置，不继续做缓存调优。
SV_VISION_INPUT_LAYOUT=prefix-first
SV_VISION_SCHEMA=1
