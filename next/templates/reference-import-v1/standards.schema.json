{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "正品标准批量导入 v1",
  "description": "模板协议草案。每条对应一个物料编号和供应商名称组合。",
  "type": "object",
  "required": ["schemaVersion", "records"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["materialCode", "supplierName", "imagePath"],
        "additionalProperties": false,
        "properties": {
          "materialCode": {"type": "string", "minLength": 1, "description": "保留前导零，与 MES 物料编号一致"},
          "supplierName": {"type": "string", "minLength": 1, "description": "与 MES 供应商名称一致"},
          "imagePath": {"type": "string", "minLength": 1, "description": "包内相对路径，例如 images/demo-reference.png"},
          "description": {"type": "string", "description": "可选，自由文本检测指导，允许换行"}
        }
      }
    }
  }
}
